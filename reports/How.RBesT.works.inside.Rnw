<<load-data, echo=FALSE, message=FALSE, warning=FALSE, fig.width=12, fig.height=8>>=
## Load RDS outputs generated by 1.1_Fixed.prior.control.R
library(ggplot2)
library(dplyr)
library(tidyr)
library(knitr)

# We knit from the report folder, so need to go one step up
data_dir <- file.path("..", "data")

t1e_path <- file.path(data_dir, "T1E.fixed.rds")
avg_path <- file.path(data_dir, "avgT1E.fixed.rds")

# read files
t1e_fixed <- if (file.exists(t1e_path)) readRDS(t1e_path) else NULL
avg_t1e_fixed <- if (file.exists(avg_path)) readRDS(avg_path) else NULL

# T1E plot (2x2: row1 Signif95 | Dual95 ; row2 Signif97.5 | Dual97.5)
  t1e_fixed$Decision <- factor(t1e_fixed$Decision,
                               levels = c("Significance (95%)", "Dual (95%)",
                                          "Significance (97.5%)", "Dual (97.5%)"))
  lines_df <- data.frame(
    Decision = factor(c("Significance (95%)", "Dual (95%)", "Significance (97.5%)", "Dual (97.5%)"),
                      levels = levels(t1e_fixed$Decision)),
    y = c(0.05, 0.05, 0.025, 0.025)
  )

  p1 <- ggplot(t1e_fixed, aes(x = theta, y = T1E, color = Prior)) +
    geom_line(linewidth = 1) +
    geom_vline(xintercept = -50, linetype = "dashed", alpha = 0.5) +
    facet_wrap(~ Decision, ncol = 2) +
    labs(title = "Classic Type I Error",
         x = "True Mean CDAI Change from Baseline",
         y = "Type I Error",
         color = "Analysis Prior") +
    theme_bw() +
    ylim(0, 1) +
    geom_hline(data = lines_df, aes(yintercept = y), linetype = "dotted", inherit.aes = FALSE)

  print(p1)

@

<<avg-t1e-tables, echo=FALSE, message=FALSE, warning=FALSE, results='asis', fig.width=12, fig.height=8>>=

library(knitr)
library(kableExtra)

 colnames(avg_t1e_fixed)[6] <- "Robust"

  avg_long <- avg_t1e_fixed %>%
    mutate(
      Analysis_Prior = factor(Analysis_Prior, levels = c("Vague", "MAP", "Robust"))
    ) %>%
    arrange(Analysis_Prior) %>%
    select(Analysis_Prior, Decision_Criteria, Vague, Skeptical, MAP, Robust) %>%
    mutate(across(c("Vague", "Skeptical", "MAP", "Robust"), ~round(. * 100, 2)))

  criteria_order <- c(
    "Significance (95%)",
    "Significance (97.5%)",
    "Dual (95%)",
    "Dual (97.5%)"
  )

  for (i in seq_along(criteria_order)) {
    criterion <- criteria_order[i]
    tab <- avg_long %>%
      filter(Decision_Criteria == criterion) %>%
      select(Analysis_Prior, Vague, Skeptical, MAP, Robust)


      criterion_caption <- gsub("%", "\\%", criterion, fixed = TRUE)

      print(
        tab %>%
          kbl(
            format = "latex",
            booktabs = TRUE,
            align = "lrrrr",
            label = paste0("avg-t1e-", i),
            caption = paste0("Average Type I Error - ", criterion_caption),
            col.names = c("Analysis Prior", "Vague (%)", "Skeptical (%)", "MAP (%)", "Robust (%)")
          ) %>%
          kable_styling(latex_options = c("hold_position"), font_size = 8)
      )

      cat("\n\n")
    }
  


@

<<avg-t1e-plot, echo=FALSE, message=FALSE, warning=FALSE, fig.cap="Average Type I Error", fig.width=12, fig.height=8>>=
# Average T1E plot

  # long
  df_plot_avg <- avg_t1e_fixed %>%
    tidyr::pivot_longer(cols = c("Vague", "Skeptical", "MAP", "Robust"),
                        names_to = "Design_Prior", values_to = "Avg_T1E") %>%
    mutate(
      Analysis_Prior = factor(Analysis_Prior, levels = c("Vague", "MAP", "Robust")),
      Design_Prior = factor(Design_Prior, levels = c("Vague", "Skeptical", "MAP", "Robust")),
      Decision_Criteria = factor(Decision_Criteria,
                                 levels = c("Significance (95%)", "Dual (95%)",
                                            "Significance (97.5%)", "Dual (97.5%)"))
    ) 

  ref_lines <- data.frame(
    Decision_Criteria = factor(c("Significance (95%)", "Dual (95%)", "Significance (97.5%)", "Dual (97.5%)"),
                               levels = levels(df_plot_avg$Decision_Criteria)),
    y = c(5, 5, 2.5, 2.5)
  )

  p3 <- ggplot(df_plot_avg, aes(x = Design_Prior, y = Avg_T1E * 100, fill = Analysis_Prior)) +
    geom_col(position = position_dodge(width = 0.7), width = 0.6) +
    facet_wrap(~ Decision_Criteria, ncol = 2) +
    geom_hline(data = ref_lines, aes(yintercept = y), linetype = "dashed", color = "red", alpha = 0.7, inherit.aes = FALSE) +
    labs(title = "Average Type I Error",
         x = "Design Prior",
         y = "Average Type I Error (%)",
         fill = "Analysis Prior") +
    scale_y_continuous(limits = c(0, max(10, max(df_plot_avg$Avg_T1E * 100, na.rm = TRUE)))) +
    scale_fill_manual(values = c("Vague" = "#E69F00", "MAP" = "#56B4E9", "Robust" = "#009E73")) +
    theme_bw() +
    theme(legend.position = "bottom", axis.text.x = element_text(angle = 45, hjust = 1))

  print(p3)

@










\section{Sequential design}
Presentation of the sequential design. Now we show the formula in closed for for two stages, more stages we should use Monte Carlo simulations..... 
Using MC also allow us to use more complex futility rules like predictive prob of success! 


\subsection{Implementation using oc2S\_seq.normMix function}
First, we define the variables: 
\begin{itemize}
  \item  $i \in \{1, 2\}$ denotes the arm, where $1$ is the Treatment group and $2$ is the Placebo group.
  \item  $j \in \{1, 2\}$ denotes the stage, where $1$ is the Interim analysis and $2$ is the Final analysis
  \item $n_{i,j}$: The cumulative sample size for arm $i$ at stage $j$. 
  \item $\theta_i$ and $\sigma_i$:  the true, fixed underlying treatment effect and the known standard deviation of the individual patient responses in arm $i$.
  \item $y_{i,j}$: The observed sample mean for arm $i$ at stage $j$.
\end{itemize}

\paragraph{Stage 1}
At the interim analysis, the data we observe depends entirely on the true underlying effects ($\theta$) and the sample size collected so far. The standard error at Stage 1 is the Marginal Standard Error: 
$$mSEM_{i,1} = \frac{\sigma_i}{\sqrt{n_{i,1}}}$$ 
Therefore, the Stage 1 data follows a normal distribution centered on the true effect: 
$$y_{i,1} \sim \mathcal{N}(\theta_i, mSEM_{i,1}^2)$$

\paragraph{Stage 2}
If the trial continues to Stage 2, the final mean ($y_{i,2}$) is not entirely random since it contains the data we already observed at Stage 1 ($y_{i,1}$). 
Therefore, we must define the distribution of the final mean conditional on the interim mean. The final cumulative mean is a weighted average of the observed interim data and the unobserved future data. 
Given the interim result $y_{i,1}$, the expected final result pulls the interim data toward the true underlying effect $\theta_i$:
$$\E[]{y_{i,2} | y_{i,1}} = \frac{n_{i,1}y_{i,1} + (n_{i,2} - n_{i,1})\theta_i}{n_{i,2}}$$


Moreover, the variance of the final mean shrinks accordingly: 
$$\mathbb{V}\text{ar}(y_{i,2} \mid y_{i,1}) = \frac{\sigma_i^2 (n_{i,2} - n_{i,1})}{n_{i,2}^2}$$ 

Therefore, the Stage 2 data, conditional on Stage 1, follows a shifted and narrowed normal distribution:
$$f_{i,2|1}(y_{i,2}) \sim \mathcal{N} \left(\E[]{y_{i,2} | y_{i,1}} , \mathbb{V}\text{ar}(y_{i,2} \mid y_{i,1}) \right)$$


\paragraph{Decision Regions}
We define regions where the treatment mean ($y_{1,j}$) must land to trigger a specific trial decision, conditional on the placebo mean ($y_{2,j}$). 
\begin{itemize}
\item $\mathcal{S}_j(y_{2,j})$: The Success Region at stage $j$.  
\item $\mathcal{F}_1(y_{2,1})$: The Futility Region at stage 1.
\item $\mathcal{C}_1(y_{2,1})$: The Continuation Region at stage 1 (the space between $\mathcal{F}_1$ and $\mathcal{S}_1$).
\end{itemize}


\paragraph{Computations for stage 1}
At the interim analysis, the probability of the trial stopping early is the probability mass of the treatment mean falling into either the success or futility regions, integrated across the marginal distributions $f_{i,1}$. 
To formalize this we can generalize Equation~\eqref{eq:oc2S} and write:

Probability of Early Success ($P_{succ,1}$): $$P_{succ,1}(\theta_2, \delta) = \int_{-\infty}^{\infty} f_{2,1}(y_{2,1} | \theta_2) \left[ \int_{\mathcal{S}_1(y_{2,1})} f_{1,1}(y_{1,1} | \theta_1) \, dy_{1,1} \right] dy_{2,1}$$ 
Probability of Futility Stop ($P_{fut,1}$):$$P_{fut,1}(\theta_2, \delta) = \int_{-\infty}^{\infty} f_{2,1}(y_{2,1} | \theta_2) \left[ \int_{\mathcal{F}_1(y_{2,1})} f_{1,1}(y_{1,1} | \theta_1 ) \, dy_{1,1} \right] dy_{2,1}$$
Probability of Continuing ($P_{cont,1}$): $$P_{cont,1}(\theta_2, \delta) = 1 - P_{succ,1}(\theta_2, \delta) - P_{fut,1}(\theta_2, \delta)$$

\paragraph{Computations for stage 2}
The trial reaches Stage 2 only if the interim treatment mean $y_{1,1}$ lands inside the continuation region $\mathcal{C}_1$. We integrate over this region using the marginal Stage 1 distributions, 
but the inner integral evaluating final success uses the conditional distributions $f_{i,2|1}$ defined above. 

Probability of Final Success ($P_{succ,2}$): $$P_{succ,2}(\theta_2, \delta) = \int_{-\infty}^{\infty} f_{2,1}(y_{2,1} | \theta_2) \int_{\mathcal{C}_1(y_{2,1})} f_{1,1}(y_{1,1}| \theta_1) \left[ I_{inner}(y_{1,1}, y_{2,1} | \theta_1, \theta_2) \right] dy_{1,1} \, dy_{2,1}$$
Where the inner final-stage integral evaluates the final data against the final success region:
$$I_{inner}(y_{1,1}, y_{2,1} |  \theta_1, \theta_2) = \int_{-\infty}^{\infty} f_{2,2|1}(y_{2,2} | \theta_2) \left[ \int_{\mathcal{S}_2(y_{2,2})} f_{1,2|1}(y_{1,2} | \theta_1) \, dy_{1,2} \right] dy_{2,2}$$


\paragraph{Outputs}
Finally: $$P_{succ, seq}(\theta_2, \delta) = P_{succ,1}(\theta_2, \delta) + P_{succ,2}(\theta_2, \delta)$$



\subsection{Extension for the Average T1E}
Next step is to implement the average type 1 error. Just like in the fixed case we need to marginalize the pintwise probability of success over the design prior $p(\theta_2)$ while $\theta_1 = \delta + \theta_2$: 
$$m_{seq}(\delta) = \int_{-\infty}^{\infty} P_{succ, seq}(\theta_2, \delta) \, p(\theta_2) \, d\theta_2$$
Function will be called avgT1E\_seq.normMix function


\subsection{Implementation in the case study}
The original case study for the Crohn's disease comprised a two stage desing with an interim stop \cite{gsponer2014bayesian} \cite{Crohn}. 
10 patients are allocated to placebo and 20 to the experimental arm. Then, success criteria is:  $Pr(\delta < 0 | Data) \ge 0.95$ and $Pr(\delta < -50 | Data) \ge 0.50$, while stopping for futility happens if 
 $Pr(\delta > 40 | Data) \ge 0.90$. If neitherr occurs, then another 10 patients are allocated to placebo and another 20 to the experimental treatment.


 [PUT RESULTS]

 


\section{Prior on the Treatment Effect ($\delta$)}
Alternatively, when researchers have specific prior beliefs or historical data regarding the relative difference between the arms, we can parametrize the design prior directly on the treatment effect, $\delta$. Then $m$ can be written as:
$$m = \int_{-\infty}^{\infty} \Prob{\text{Success} \mid \delta} p(\delta) \, d\delta$$




