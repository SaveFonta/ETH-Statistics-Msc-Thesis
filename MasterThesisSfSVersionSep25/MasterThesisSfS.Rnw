\begin{document}
<<setup, include=FALSE>>=
## knitr runs each child chunk from the CHILD file's own directory, which would
## break the ../Output and ../scripts paths inside Chapters/. Pinning root.dir to
## the master's directory makes every chunk resolve them exactly as in Final/.
knitr::opts_knit$set(root.dir = getwd())
library(knitr)
## cache is off by default on purpose. knitr keys its cache on the chunk code
## alone, so a cached chunk that reads ../Output/*.RDS keeps showing the old
## numbers after a script is rerun, with no warning and a clean build. Almost
## every chunk here reads an RDS, and they are cheap. Caching is switched back
## on only for the gMAP chunks of the Methodology, which are genuinely
## expensive and read no results file, so their cache cannot go stale.
opts_chunk$set(echo = FALSE,
               message = FALSE,
               warning = FALSE,
               cache = FALSE,
               fig.align = "center",
               fig.height = 4,
               dev = 'cairo_pdf' # with this the plots can have greek letters
               )
options(scipen = 10)

# Shared colour palette, reused across every figure in the
# manuscript so that SC/DC and Average/Conditional always match.
col_sc   <- "#0072B2"
col_dc   <- "#D55E00"
col_avg  <- "#E69F00"
col_cond <- "#56B4E9"
@
