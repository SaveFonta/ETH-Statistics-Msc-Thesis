\subsubsection{Fixed Design}
Best et al. evaluated the fixed design, so we first implement it, using $n_C = 20$ and $n_T = 40$

 

\subsubsection{One interim analysis}
We now reproduce the results from \citep{gsponer_practical_2014} using as priors an informative $\theta_C \sim N(-49, (88 / 20)^2)$ and a vague $\theta_T \sim N(-50, 8800^2) $. To compute the traditional Type I error, we assume a fixed true value $\theta_C = -49$,
while for the Average Type I error we assume that design prior coincides with analysis prior, see Figure~\ref{fig:GSPONER.plot} for the full Operating Charatcteristics. 



<<GSPONER.preparation, echo=FALSE, cache=TRUE, results='asis', cache.extra=file.mtime("../scripts/prior_on_control/1.2_Gsponer.T1E_and_avgT1E.control.R")>>=
gsponer <- readRDS("../data/reproduce.Gsponer.rds")
res <- gsponer$res
final_tab <- format.results(res)

tab.gsponer <- final_tab$per_stage %>%
  select(
    Delta, 
    P_Succ.Interim_1,
    P_Succ.Final, P_Fut.Interim_1, P_Ind.Final, Cum_P_Succ.Final
  )

overall <- final_tab$overall %>%
select(Delta, E_N, E_N_Succ, E_N_Fail)


# Average metrics
res.avg <- gsponer$res.avg
final_tab.avg <- format.results(res.avg)

tab.gsponer.avg <- final_tab.avg$per_stage %>%
  select(
    Delta, 
    P_Succ.Interim_1,
    P_Succ.Final, P_Fut.Interim_1, P_Ind.Final, Cum_P_Succ.Final
  )

overall.avg <- final_tab.avg$overall %>%
select(Delta, E_N, E_N_Succ, E_N_Fail)
@





<<GSPONER.combined_panel, echo=FALSE, results='asis', cache=FALSE, dependson="GSPONER.preparation", cache.extra=file.mtime("../scripts/prior_on_control/1.2_Gsponer.T1E_and_avgT1E.control.R")>>=


